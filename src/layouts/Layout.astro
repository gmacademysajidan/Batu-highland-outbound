---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';
import { siteConfig } from '../data/content';
import { buildPageSchemaGraph, type BreadcrumbItem, SITE_URL } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  pageType?: string;
  breadcrumbs?: BreadcrumbItem[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = `${siteConfig.name} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = '/img/tim_building_perusahaan.webp',
  canonicalUrl = `${SITE_URL}${Astro.url.pathname}`,
  type = 'website',
  pageType = 'WebPage',
  breadcrumbs,
  schema
} = Astro.props;

const currentPath = Astro.url.pathname;
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;

// Generate unified Schema.org JSON-LD graph
const pageSchema = buildPageSchemaGraph({
  url: canonicalUrl,
  title,
  description,
  pageType,
  breadcrumbs,
  customNodes: schema
});
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data for Schema.org / Google Rich Results / AEO / GEO -->
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema, null, 2)} />
  </head>
  <body class="bg-[#F8F7F2] text-[#242824] antialiased flex flex-col min-h-screen">
    <Header currentPath={currentPath} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <WhatsAppButton />
  </body>
</html>
