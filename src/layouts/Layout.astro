---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';
import { siteConfig } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  schema?: Record<string, any>;
}

const {
  title = `${siteConfig.name} - ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = '/img/tim_building_perusahaan.webp',
  canonicalUrl = Astro.url.href,
  type = 'website',
  schema
} = Astro.props;

const currentPath = Astro.url.pathname;

// Default Organization & LocalBusiness JSON-LD schema
const defaultOrgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `https://${siteConfig.domain}/#organization`,
      "name": siteConfig.name,
      "url": `https://${siteConfig.domain}`,
      "logo": `https://${siteConfig.domain}/logo.png`,
      "image": image,
      "description": siteConfig.description,
      "telephone": siteConfig.phone,
      "email": siteConfig.email,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address,
        "addressLocality": "Kota Batu",
        "addressRegion": "Jawa Timur",
        "addressCountry": "ID"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "08:00",
          "closes": "20:00"
        }
      ],
      "sameAs": [
        siteConfig.socials.instagram,
        siteConfig.socials.facebook,
        siteConfig.socials.youtube
      ]
    }
  ]
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Structured Data for AEO / GEO / Google Rich Results -->
    <script type="application/ld+json" set:html={JSON.stringify(schema || defaultOrgSchema)} />
  </head>
  <body class="bg-[#F8F7F2] text-[#242824] antialiased flex flex-col min-h-screen">
    <Header currentPath={currentPath} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <WhatsAppButton />
  </body>
</html>
