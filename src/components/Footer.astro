---
import { siteConfig, getWhatsAppUrl } from '../data/content';
---

<footer class="bg-[#173D32] text-[#F8F7F2] border-t border-[#657A50]/30 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[#657A50]/40">
      
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#657A50] text-[#F8F7F2] flex items-center justify-center font-bold text-xl">
            RR
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-white block">
              RUANG RIMBA
            </span>
            <span class="text-[10px] tracking-widest uppercase font-semibold text-[#E8DFC9] block">
              OUTBOUND & ADVENTURE
            </span>
          </div>
        </div>
        <p class="text-sm text-gray-300 leading-relaxed pr-4">
          Ruang Rimba Outbound adalah mitra terpercaya penyelenggaraan program outbound training, team building, employee gathering, leadership camp sekolah, dan wisata petualangan alam di Jabodetabek, Bandung, dan sekitarnya.
        </p>
        <div class="pt-2">
          <a
            href={getWhatsAppUrl("Halo Ruang Rimba, saya ingin konsultasi kebutuhan event kami")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#657A50] hover:bg-[#657A50]/80 text-white text-xs font-semibold px-4 py-2.5 rounded-lg transition"
          >
            <svg class="w-4 h-4 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            Konsultasi Program Gratis
          </a>
        </div>
      </div>

      <!-- Outbound Perusahaan & Family -->
      <div>
        <h4 class="text-sm font-bold tracking-wider uppercase text-[#E8DFC9] mb-4">Layanan Populer</h4>
        <ul class="space-y-2.5 text-xs text-gray-300">
          <li><a href="/team-building" class="hover:text-white transition">Team Building Outbound</a></li>
          <li><a href="/fun-games" class="hover:text-white transition">Fun Games & Ice Breaking</a></li>
          <li><a href="/leadership-camp" class="hover:text-white transition">Leadership Camp</a></li>
          <li><a href="/corporate-gathering" class="hover:text-white transition">Corporate Gathering</a></li>
          <li><a href="/paket-standard" class="hover:text-white transition">Family Gathering Standard</a></li>
          <li><a href="/paket-premium" class="hover:text-white transition">Family Gathering Premium</a></li>
        </ul>
      </div>

      <!-- Outbound Wisata & Edukasi -->
      <div>
        <h4 class="text-sm font-bold tracking-wider uppercase text-[#E8DFC9] mb-4">Petualangan & Sekolah</h4>
        <ul class="space-y-2.5 text-xs text-gray-300">
          <li><a href="/outbound-rafting" class="hover:text-white transition">Outbound + Rafting Sungai</a></li>
          <li><a href="/outbound-offroad" class="hover:text-white transition">Outbound + Offroad 4x4</a></li>
          <li><a href="/outbound-camping" class="hover:text-white transition">Camping & Glamping Rimba</a></li>
          <li><a href="/outbound-pelajar" class="hover:text-white transition">Outbound Pelajar & Anak</a></li>
          <li><a href="/ldks-leadership" class="hover:text-white transition">LDKS & Kepemimpinan Siswa</a></li>
          <li><a href="/edukasi-alam" class="hover:text-white transition">Edukasi Konservasi Rimba</a></li>
        </ul>
      </div>

      <!-- Kontak & Info Legal -->
      <div>
        <h4 class="text-sm font-bold tracking-wider uppercase text-[#E8DFC9] mb-4">Kontak Resmi</h4>
        <ul class="space-y-2 text-xs text-gray-300">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#E8DFC9] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
            <span>{siteConfig.address}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#E8DFC9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span>{siteConfig.phone}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#E8DFC9] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <span>{siteConfig.email}</span>
          </li>
          <li class="pt-2 text-[11px] text-[#E8DFC9]">
            Jam Layanan:<br />{siteConfig.workingHours}
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <div>
        &copy; {new Date().getFullYear()} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.
      </div>
      <div class="flex items-center space-x-6">
        <a href="/kebijakan-privasi" class="hover:text-white transition">Kebijakan Privasi</a>
        <a href="/syarat-ketentuan" class="hover:text-white transition">Syarat & Ketentuan</a>
        <a href="/sitemap-info" class="hover:text-white transition">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
