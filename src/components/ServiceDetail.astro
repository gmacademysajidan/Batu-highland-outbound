---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { servicePackages, getWhatsAppUrl, siteConfig, type ServicePackage } from '../data/content';

interface Props {
  pkg: ServicePackage;
}

const { pkg } = Astro.props;

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": pkg.title,
      "serviceType": pkg.categoryLabel,
      "provider": {
        "@type": "LocalBusiness",
        "name": siteConfig.name,
        "telephone": siteConfig.phone,
        "url": `https://${siteConfig.domain}`
      },
      "description": pkg.fullDesc,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "IDR",
        "availability": "https://schema.org/InStock",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "description": pkg.pricingNote
        }
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": pkg.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title={`${pkg.title} - ${siteConfig.name}`}
  description={`${pkg.shortDesc} Pelajari rundown, sasaran pelatihan, fasilitas, dan konsultasi paket melalui WhatsApp.`}
  image={pkg.heroImage}
  schema={serviceSchema}
>
  <!-- Top Breadcrumb -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumb
      items={[
        { label: 'Paket Outbound', href: '/paket' },
        { label: pkg.categoryLabel, href: `/paket#${pkg.category}` },
        { label: pkg.title }
      ]}
    />
  </div>

  <!-- Hero Section -->
  <section class="relative bg-[#173D32] text-white py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-20 mix-blend-overlay">
      <img src={pkg.heroImage} alt={pkg.title} class="w-full h-full object-cover" />
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#657A50]/50 border border-[#657A50] text-[#E8DFC9] text-xs font-semibold uppercase tracking-wider">
            {pkg.categoryLabel}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
            {pkg.title}
          </h1>
          <p class="text-sm sm:text-base text-[#E8DFC9] leading-relaxed max-w-3xl">
            {pkg.fullDesc}
          </p>

          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href={getWhatsAppUrl(`Halo Ruang Rimba, saya tertarik dengan paket ${pkg.title}. Boleh minta info detail harga dan ketersediaan tanggal?`)}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3.5 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-sm transition flex items-center gap-2 shadow-lg"
            >
              <svg class="w-5 h-5 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              Konsultasi Paket Ini via WhatsApp
            </a>
            <a
              href="#rundown"
              class="px-6 py-3.5 rounded-xl border border-[#E8DFC9] text-[#E8DFC9] hover:bg-white/10 font-bold text-sm transition"
            >
              Lihat Rundown Kegiatan
            </a>
          </div>
        </div>

        <div class="lg:col-span-4">
          <div class="bg-white/95 text-[#242824] rounded-2xl p-6 shadow-2xl border border-[#E8DFC9] space-y-4">
            <h3 class="font-bold text-sm text-[#173D32] uppercase tracking-wider border-b border-[#E8DFC9] pb-2">
              Ringkasan Layanan
            </h3>
            <div class="space-y-3 text-xs">
              <div>
                <span class="text-gray-500 block">Investasi:</span>
                <span class="font-bold text-[#173D32] text-sm">{pkg.pricingNote}</span>
              </div>
              <div>
                <span class="text-gray-500 block">Pilihan Durasi:</span>
                <ul class="list-disc list-inside font-medium text-gray-800 mt-0.5">
                  {pkg.durationOptions.map(d => <li>{d}</li>)}
                </ul>
              </div>
              <div>
                <span class="text-gray-500 block">Rekomendasi Venue:</span>
                <span class="font-medium text-gray-800">{pkg.recommendedVenues.join(', ')}</span>
              </div>
            </div>
            <div class="pt-2">
              <a
                href={getWhatsAppUrl(`Halo Ruang Rimba, saya ingin request proposal resmi untuk paket: ${pkg.title}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full text-center block py-2.5 rounded-lg bg-[#173D32] hover:bg-[#657A50] text-[#E8DFC9] font-bold text-xs transition"
              >
                Request Proposal Resmi
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Detail Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Main Content (Left 8 Cols) -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Tujuan & Manfaat -->
        <section class="bg-white p-8 rounded-2xl border border-[#E8DFC9] space-y-4">
          <h2 class="text-2xl font-bold text-[#173D32] flex items-center gap-2">
            <svg class="w-6 h-6 text-[#657A50]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Tujuan & Manfaat Kegiatan
          </h2>
          <ul class="space-y-3 pt-2">
            {pkg.objectives.map((obj) => (
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</span>
                <span>{obj}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Target Peserta & Keunggulan -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-[#F8F7F2] p-6 rounded-2xl border border-[#E8DFC9] space-y-3">
            <h3 class="font-bold text-base text-[#173D32]">Target Peserta</h3>
            <ul class="space-y-1.5 text-xs text-gray-600">
              {pkg.targetAudience.map(t => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#657A50]"></span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-[#F8F7F2] p-6 rounded-2xl border border-[#E8DFC9] space-y-3">
            <h3 class="font-bold text-base text-[#173D32]">Keunggulan Program</h3>
            <ul class="space-y-1.5 text-xs text-gray-600">
              {pkg.highlights.map(h => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#657A50]"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Rundown Kegiatan -->
        <section id="rundown" class="scroll-mt-28 space-y-6">
          <div class="border-b border-[#E8DFC9] pb-3">
            <h2 class="text-2xl font-bold text-[#173D32]">Contoh Rundown & Simulasi Aktivitas</h2>
            <p class="text-xs text-gray-500 mt-1">Jadwal dapat disesuaikan dengan kebutuhan dan durasi kedatangan rombongan Anda.</p>
          </div>

          <div class="space-y-4">
            {pkg.rundown.map((item) => (
              <div class="flex gap-4 p-4 rounded-xl bg-white border border-[#E8DFC9] hover:border-[#657A50] transition">
                <div class="w-28 shrink-0">
                  <span class="inline-block px-2.5 py-1 rounded bg-[#E8DFC9]/50 text-[#173D32] font-mono font-bold text-xs">
                    {item.time}
                  </span>
                </div>
                <div>
                  <h3 class="font-bold text-sm text-[#173D32]">{item.activity}</h3>
                  <p class="text-xs text-gray-600 mt-1 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Fasilitas Termasuk -->
        <section class="bg-white p-8 rounded-2xl border border-[#E8DFC9] space-y-4">
          <h2 class="text-2xl font-bold text-[#173D32]">Fasilitas yang Didapatkan</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {pkg.facilities.map((fac) => (
              <div class="flex items-start gap-2.5 text-xs text-gray-700">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>{fac}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- Galeri Terkait -->
        {pkg.galleryImages && pkg.galleryImages.length > 0 && (
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-[#173D32]">Dokumentasi Terkait</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
              {pkg.galleryImages.map((img) => (
                <div class="aspect-[4/3] rounded-xl overflow-hidden border border-[#E8DFC9]">
                  <img src={img} alt={pkg.title} class="w-full h-full object-cover hover:scale-105 transition duration-300" />
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- FAQ Spesifik Paket -->
        {pkg.faqs && pkg.faqs.length > 0 && (
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-[#173D32]">FAQ {pkg.title}</h2>
            <div class="space-y-3">
              {pkg.faqs.map((faq) => (
                <div class="p-5 rounded-xl bg-white border border-[#E8DFC9]">
                  <h3 class="font-bold text-sm text-[#173D32]">{faq.question}</h3>
                  <p class="text-xs text-gray-600 mt-2 leading-relaxed">{faq.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}

      </div>

      <!-- Sticky Sidebar (Right 4 Cols) -->
      <div class="lg:col-span-4">
        <div class="sticky top-28 space-y-6">
          
          <!-- CTA Card -->
          <div class="bg-[#173D32] text-white p-6 rounded-2xl shadow-xl space-y-4">
            <h3 class="font-bold text-lg text-white">Butuh Konsultasi & Proposal Cepat?</h3>
            <p class="text-xs text-[#E8DFC9] leading-relaxed">
              Hubungi tim marketing kami sekarang. Kami siap menghitungkan estimasi anggaran dan membuatkan rundown kustom hari ini juga.
            </p>
            <div class="space-y-3 pt-2">
              <a
                href={getWhatsAppUrl(`Halo Ruang Rimba, saya butuh penawaran paket: ${pkg.title}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-xs flex items-center justify-center gap-2 transition"
              >
                <svg class="w-4 h-4 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                Chat WhatsApp Sekarang
              </a>
              <a
                href="/kontak"
                class="w-full py-2.5 rounded-xl border border-[#E8DFC9] text-[#E8DFC9] hover:bg-white/10 font-bold text-xs flex items-center justify-center transition"
              >
                Lihat Kontak & Lokasi Kantor
              </a>
            </div>
          </div>

          <!-- Other Packages in Same Category -->
          <div class="bg-white p-6 rounded-2xl border border-[#E8DFC9] space-y-4">
            <h3 class="font-bold text-sm text-[#173D32] uppercase tracking-wider border-b border-[#E8DFC9] pb-2">
              Paket {pkg.categoryLabel} Lainnya
            </h3>
            <div class="space-y-3">
              {servicePackages
                .filter(p => p.category === pkg.category && p.slug !== pkg.slug)
                .map(other => (
                  <a href={`/${other.slug}`} class="block p-2 rounded-lg hover:bg-[#F8F7F2] transition group">
                    <div class="font-bold text-xs text-[#173D32] group-hover:text-[#657A50]">{other.title}</div>
                    <div class="text-[11px] text-gray-500 line-clamp-1 mt-0.5">{other.shortDesc}</div>
                  </a>
                ))
              }
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>
