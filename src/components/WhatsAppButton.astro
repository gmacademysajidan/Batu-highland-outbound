---
import { getWhatsAppUrl } from '../data/content';
---

<!-- Floating WhatsApp Action Button -->
<div class="fixed bottom-6 right-6 z-50 flex items-center group">
  <div class="hidden sm:flex mr-3 bg-white/95 text-[#173D32] px-4 py-2 rounded-full shadow-lg border border-[#E8DFC9] text-xs font-semibold items-center gap-2 transition-all opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0">
    <span>Tanya Paket & Konsultasi</span>
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
  </div>
  <a
    href={getWhatsAppUrl("Halo Ruang Rimba Outbound, saya ingin konsultasi mengenai paket kegiatan.")}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Hubungi kami melalui WhatsApp"
    class="w-14 h-14 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition duration-300 relative"
  >
    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500"></span>
    </span>
    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
  </a>
</div>
