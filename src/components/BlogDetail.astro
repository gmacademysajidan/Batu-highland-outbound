---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { blogPosts, getWhatsAppUrl, siteConfig, type BlogPost } from '../data/content';
import { getArticleSchema, SITE_URL } from '../utils/schema';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const relatedPosts = blogPosts.filter(p => p.slug !== post.slug).slice(0, 2);
const currentUrl = `${SITE_URL}/blog/${post.slug}`;
const breadcrumbItems = [
  { label: 'Blog', href: '/blog' },
  { label: post.title }
];

const articleNode = getArticleSchema(post, currentUrl);
---

<Layout
  title={`${post.title} - Blog Ruang Rimba`}
  description={post.summary}
  image={post.featuredImage}
  type="article"
  pageType="ItemPage"
  breadcrumbs={breadcrumbItems}
  schema={articleNode}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumb
      items={breadcrumbItems}
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- MAIN ARTICLE COLUMN (Left: 8 cols on desktop) -->
      <article class="lg:col-span-8 space-y-8 min-w-0">
        
        <!-- Header Post -->
        <header class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E8DFC9] text-[#173D32] text-xs font-bold uppercase tracking-wider">
            {post.category}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#173D32] leading-tight">
            {post.title}
          </h1>
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-gray-500 border-b border-[#E8DFC9] pb-4">
            <span>Ditulis oleh: <strong class="text-[#173D32]">{post.author}</strong></span>
            <span>•</span>
            <span>{post.date}</span>
            <span>•</span>
            <span>{post.readingTime}</span>
          </div>
        </header>

        <!-- Featured Image -->
        <div class="rounded-3xl overflow-hidden shadow-lg border border-[#E8DFC9] aspect-[16/9]">
          <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover" />
        </div>

        <!-- MOBILE TOC (Hanya muncul di versi Mobile di bawah gambar: block lg:hidden) -->
        {post.toc && post.toc.length > 0 && (
          <div class="block lg:hidden">
            <details class="group bg-white rounded-2xl border border-[#E8DFC9] p-5 shadow-sm transition-all duration-300" open>
              <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                <div class="flex items-center gap-2.5 font-bold text-sm text-[#173D32]">
                  <div class="w-7 h-7 rounded-lg bg-[#173D32] text-[#E8DFC9] flex items-center justify-center shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                  </div>
                  <span>Daftar Isi Panduan</span>
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#E8DFC9] text-[#173D32] font-semibold">{post.toc.length} Bagian</span>
                </div>
                <div class="w-7 h-7 rounded-lg bg-[#F8F7F2] text-[#173D32] flex items-center justify-center transition-transform duration-300 group-open:rotate-180 shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </summary>
              <div class="mt-4 pt-4 border-t border-[#E8DFC9]">
                <ul class="space-y-2.5 text-xs text-gray-700">
                  {post.toc.map((item, idx) => (
                    <li>
                      <a href={`#${item.id}`} class="hover:text-[#173D32] hover:font-bold hover:translate-x-1 transition-all flex items-start gap-2.5 group/item">
                        <span class="w-5 h-5 rounded-md bg-[#F8F7F2] group-hover/item:bg-[#173D32] group-hover/item:text-white text-[#657A50] font-bold flex items-center justify-center text-[10px] shrink-0 transition">
                          {idx + 1}
                        </span>
                        <span class="leading-snug">{item.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </div>
        )}

        <!-- Main Content Body -->
        <div class="prose prose-emerald max-w-none text-[#242824] leading-relaxed text-sm sm:text-base space-y-4" set:html={post.content}>
        </div>

        <!-- Bottom Article CTA Card -->
        <div class="my-14 bg-[#173D32] rounded-3xl p-8 sm:p-12 text-white shadow-2xl border-2 border-[#657A50]/40 relative overflow-hidden">
          
          <!-- Background accent subtle -->
          <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-[#657A50]/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -left-16 -top-16 w-64 h-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

          <div class="relative z-10 text-center max-w-2xl mx-auto space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#657A50]/40 border border-[#657A50] text-[#E8DFC9] text-xs font-semibold uppercase tracking-wider">
              Konsultasi Program Outbound
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight">
              Rencanakan Outbound Terbaik Bersama Kami
            </h3>

            <p class="text-xs sm:text-sm text-[#E8DFC9] leading-relaxed">
              Diskusikan langsung kebutuhan tim dan perusahaan Anda dengan konsultan outbound Batu Highland untuk proposal dan penawaran terbaik.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
              <a
                href={getWhatsAppUrl(`Halo Batu Highland Outbound, saya baru membaca artikel '${post.title}' dan ingin konsultasi lebih lanjut.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-sm shadow-xl transition hover:scale-105 active:scale-95"
              >
                <svg class="w-5 h-5 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                Konsultasi via WhatsApp
              </a>
              <a
                href="/paket"
                class="w-full sm:w-auto px-6 py-3.5 rounded-xl border border-[#E8DFC9] text-[#E8DFC9] hover:bg-white/10 font-bold text-sm transition text-center"
              >
                Lihat Semua Paket
              </a>
            </div>
          </div>

        </div>

        <!-- Related Articles -->
        {relatedPosts.length > 0 && (
          <div class="pt-8 border-t border-[#E8DFC9] space-y-6">
            <h3 class="text-xl font-bold text-[#173D32]">Artikel Terkait Lainnya</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedPosts.map((rel) => (
                <a href={`/blog/${rel.slug}`} class="block p-4 rounded-xl bg-white border border-[#E8DFC9] hover:border-[#657A50] transition">
                  <span class="text-[10px] font-bold text-[#657A50] uppercase">{rel.category}</span>
                  <h4 class="font-bold text-sm text-[#173D32] mt-1">{rel.title}</h4>
                  <p class="text-xs text-gray-500 line-clamp-2 mt-1">{rel.summary}</p>
                </a>
              ))}
            </div>
          </div>
        )}

      </article>

      <!-- RIGHT SIDEBAR (Desktop: 4 cols, sticky) -->
      <aside class="hidden lg:block lg:col-span-4 space-y-6 sticky top-28">
        
        <!-- Desktop TOC Card (Bisa Buka dan Tutup) -->
        {post.toc && post.toc.length > 0 && (
          <details class="group bg-white rounded-2xl border border-[#E8DFC9] p-5 shadow-sm transition-all duration-300" open>
            <summary class="flex items-center justify-between cursor-pointer list-none select-none">
              <div class="flex items-center gap-2.5 font-bold text-sm text-[#173D32]">
                <div class="w-7 h-7 rounded-lg bg-[#173D32] text-[#E8DFC9] flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                </div>
                <span>Daftar Isi</span>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#E8DFC9] text-[#173D32] font-semibold">{post.toc.length} Bagian</span>
              </div>
              <div class="w-7 h-7 rounded-lg bg-[#F8F7F2] text-[#173D32] flex items-center justify-center transition-transform duration-300 group-open:rotate-180 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </summary>
            <div class="mt-4 pt-4 border-t border-[#E8DFC9] max-h-[50vh] overflow-y-auto pr-1">
              <ul class="space-y-2 text-xs text-gray-700">
                {post.toc.map((item, idx) => (
                  <li>
                    <a href={`#${item.id}`} class="hover:text-[#173D32] hover:font-bold hover:translate-x-1 transition-all flex items-start gap-2.5 group/item py-1">
                      <span class="w-5 h-5 rounded-md bg-[#F8F7F2] group-hover/item:bg-[#173D32] group-hover/item:text-white text-[#657A50] font-bold flex items-center justify-center text-[10px] shrink-0 transition">
                        {idx + 1}
                      </span>
                      <span class="leading-snug">{item.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )}

        <!-- Desktop Sidebar Card CTA -->
        <div class="bg-[#173D32] rounded-2xl p-6 text-white shadow-xl border-2 border-[#657A50]/40 relative overflow-hidden space-y-5">
          <!-- Background accent glow -->
          <div class="absolute -right-10 -bottom-10 w-40 h-40 rounded-full bg-[#657A50]/20 blur-2xl pointer-events-none"></div>
          <div class="absolute -left-10 -top-10 w-40 h-40 rounded-full bg-emerald-500/10 blur-2xl pointer-events-none"></div>

          <div class="relative z-10 space-y-4">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#657A50]/40 border border-[#657A50] text-[#E8DFC9] text-[10px] font-semibold uppercase tracking-wider">
              <svg class="w-3 h-3 text-[#E8DFC9]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
              Konsultasi Cepat
            </div>

            <h4 class="text-xl font-extrabold text-white leading-tight">
              Butuh Pendampingan Outbound di Kota Batu?
            </h4>

            <p class="text-xs text-[#E8DFC9] leading-relaxed">
              Dapatkan proposal kustom, rekomendasi venue alam sejuk, dan penawaran harga terbaik dari konsultan ahli kami.
            </p>

            <div class="pt-2 space-y-2.5">
              <a
                href={getWhatsAppUrl(`Halo Batu Highland Outbound, saya membaca artikel '${post.title}' dan tertarik konsultasi paket outbound.`)}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-xs shadow-lg transition hover:scale-[1.02] active:scale-[0.98]"
              >
                <svg class="w-4 h-4 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                Chat WhatsApp Sekarang
              </a>

              <a
                href="/paket"
                class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-xl border border-[#E8DFC9]/40 text-[#E8DFC9] hover:bg-white/10 font-semibold text-xs transition text-center"
              >
                Katalog 16 Paket Outbound
              </a>
            </div>

            <div class="pt-2 border-t border-white/10 space-y-1.5 text-[11px] text-[#E8DFC9]/80">
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Fasilitator & Master Game Bersertifikat</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Draft Proposal Siap 1x24 Jam</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Garansi Keselamatan & Asuransi</span>
              </div>
            </div>
          </div>
        </div>

      </aside>

    </div>
  </div>
</Layout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    display: none;
  }
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 6.5rem;
  }
</style>
