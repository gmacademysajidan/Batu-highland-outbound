---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig, getWhatsAppUrl } from '../data/content';

const breadcrumbItems = [{ label: 'Kontak Kami' }];

const contactSchema = {
  "@type": "ContactPoint",
  "telephone": siteConfig.phone,
  "contactType": "customer service",
  "email": siteConfig.email,
  "availableLanguage": ["id", "en"],
  "hoursAvailable": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "08:00",
    "closes": "20:00"
  }
};
---

<Layout
  title="Hubungi Kami - Batu Highland Outbound Kota Batu"
  description="Kontak resmi Batu Highland Outbound: nomor WhatsApp operasional, alamat kantor Kota Wisata Batu Malang, email, jam layanan, dan peta lokasi."
  pageType="ContactPage"
  breadcrumbs={breadcrumbItems}
  schema={contactSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="bg-[#173D32] text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E8DFC9] block mb-2">Layanan Responsif</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Hubungi Ruang Rimba</h1>
      <p class="text-sm text-[#E8DFC9] mt-2 leading-relaxed">
        Konsultasikan rencana kegiatan outbound, family gathering, LDKS sekolah, atau wisata rafting Anda bersama tim kami.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Contact Info Cards (Left 5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-[#173D32]">Informasi Kontak Bisnis</h2>
          <p class="text-xs text-gray-600 mt-1">Kami siap merespons pertanyaan Anda setiap hari.</p>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9] flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-gray-500 uppercase">WhatsApp Resmi</div>
              <a href={getWhatsAppUrl()} target="_blank" rel="noopener noreferrer" class="font-bold text-sm text-[#173D32] hover:underline block mt-0.5">
                {siteConfig.phone}
              </a>
              <div class="text-[11px] text-gray-500 mt-0.5">Respon cepat chat konsultasi</div>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9] flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-gray-500 uppercase">Email Korespondensi</div>
              <a href={`mailto:${siteConfig.email}`} class="font-bold text-sm text-[#173D32] hover:underline block mt-0.5">
                {siteConfig.email}
              </a>
              <div class="text-[11px] text-gray-500 mt-0.5">Untuk permohonan tender & proposal</div>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9] flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-gray-500 uppercase">Alamat Kantor Operasional</div>
              <p class="font-medium text-xs text-gray-800 mt-0.5 leading-relaxed">
                {siteConfig.address}
              </p>
              <div class="text-[11px] text-gray-500 mt-0.5">Jam Buka: {siteConfig.workingHours}</div>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-[#173D32] text-white space-y-3">
          <h3 class="font-bold text-base text-[#E8DFC9]">Area Layanan Kami</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Melayani pendampingan event di seluruh kawasan Kota Batu dan Jawa Timur: <strong>Kota Wisata Batu, Coban Rondo, Bumiaji, Pujon, Songgoriti, Cangar, Malang Raya, Bromo, hingga Surabaya</strong>.
          </p>
        </div>
      </div>

      <!-- Quick Inquiry Form (Right 7 Cols) -->
      <div class="lg:col-span-7 bg-white p-8 rounded-3xl border border-[#E8DFC9] shadow-sm space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-[#173D32]">Form Konsultasi & Penawaran</h2>
          <p class="text-xs text-gray-500 mt-1">Isi formulir singkat di bawah ini untuk terhubung langsung ke tim spesialis kami via WhatsApp.</p>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-bold text-gray-700 mb-1">Nama Lengkap / PIC *</label>
              <input type="text" id="name" required placeholder="Contoh: Bpk. Hendra" class="w-full px-3.5 py-2.5 rounded-xl border border-[#E8DFC9] text-xs focus:outline-none focus:border-[#173D32] bg-[#F8F7F2]" />
            </div>
            <div>
              <label for="company" class="block text-xs font-bold text-gray-700 mb-1">Nama Perusahaan / Institusi</label>
              <input type="text" id="company" placeholder="Contoh: PT Mulia Sejahtera" class="w-full px-3.5 py-2.5 rounded-xl border border-[#E8DFC9] text-xs focus:outline-none focus:border-[#173D32] bg-[#F8F7F2]" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="participants" class="block text-xs font-bold text-gray-700 mb-1">Perkiraan Jumlah Peserta</label>
              <input type="text" id="participants" placeholder="Contoh: 50 orang" class="w-full px-3.5 py-2.5 rounded-xl border border-[#E8DFC9] text-xs focus:outline-none focus:border-[#173D32] bg-[#F8F7F2]" />
            </div>
            <div>
              <label for="package-select" class="block text-xs font-bold text-gray-700 mb-1">Pilihan Paket Diminati</label>
              <select id="package-select" class="w-full px-3.5 py-2.5 rounded-xl border border-[#E8DFC9] text-xs focus:outline-none focus:border-[#173D32] bg-[#F8F7F2]">
                <option value="Team Building">Team Building Outbound</option>
                <option value="Fun Games">Fun Games & Ice Breaking</option>
                <option value="Corporate Gathering">Corporate Gathering</option>
                <option value="Leadership Camp">Leadership Camp</option>
                <option value="Family Gathering">Family Gathering</option>
                <option value="Outbound Sekolah">Outbound Sekolah / LDKS</option>
                <option value="Outbound Rafting">Outbound + Rafting Sungai</option>
                <option value="Outbound Offroad">Outbound + Offroad 4x4</option>
                <option value="Outbound Camping">Outbound + Camping Rimba</option>
                <option value="Paket Custom">Paket Kustom (Custom)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-gray-700 mb-1">Catatan Tambahan / Preferensi Lokasi</label>
            <textarea id="message" rows="4" placeholder="Sebutkan perkiraan tanggal rencana kegiatan atau kebutuhan khusus lainnya..." class="w-full px-3.5 py-2.5 rounded-xl border border-[#E8DFC9] text-xs focus:outline-none focus:border-[#173D32] bg-[#F8F7F2]"></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 rounded-xl bg-[#173D32] hover:bg-[#657A50] text-[#E8DFC9] font-bold text-xs sm:text-sm transition flex items-center justify-center gap-2 shadow"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            Kirimkan Pesan Langsung ke WhatsApp Kami
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const company = (document.getElementById('company') as HTMLInputElement).value;
    const participants = (document.getElementById('participants') as HTMLInputElement).value;
    const pkg = (document.getElementById('package-select') as HTMLSelectElement).value;
    const msg = (document.getElementById('message') as HTMLTextAreaElement).value;

    let text = `Halo Ruang Rimba Outbound,%0A%0ASaya ingin berkonsultasi mengenai paket kegiatan:%0A- *Nama PIC:* ${encodeURIComponent(name)}`;
    if (company) text += `%0A- *Instansi/Perusahaan:* ${encodeURIComponent(company)}`;
    if (participants) text += `%0A- *Estimasi Peserta:* ${encodeURIComponent(participants)}`;
    text += `%0A- *Paket Diminati:* ${encodeURIComponent(pkg)}`;
    if (msg) text += `%0A- *Catatan/Rencana Tanggal:* ${encodeURIComponent(msg)}`;

    const waNumber = "6281234567890";
    window.open(`https://wa.me/${waNumber}?text=${text}`, '_blank');
  });
</script>
