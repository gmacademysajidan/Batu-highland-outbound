<!-- Client Script untuk Slider Testimoni Otomatis di Versi Mobile -->
<script>
  let currentIndex = 0;
  const track = document.getElementById('testimonial-track');
  const dots = document.querySelectorAll('#testimonial-dots button');
  const totalSlides = dots.length;
  let autoplayInterval: any;

  function updateSlide(index: number) {
    if (window.innerWidth >= 768) {
      if (track) track.style.transform = 'none';
      return;
    }
    currentIndex = index;
    if (track) {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }
    dots.forEach((dot, i) => {
      if (i === currentIndex) {
        dot.classList.remove('bg-white/40', 'w-2.5');
        dot.classList.add('bg-[#E8DFC9]', 'w-6');
      } else {
        dot.classList.remove('bg-[#E8DFC9]', 'w-6');
        dot.classList.add('bg-white/40', 'w-2.5');
      }
    });
  }

  function nextSlide() {
    if (window.innerWidth < 768) {
      const next = (currentIndex + 1) % totalSlides;
      updateSlide(next);
    }
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayInterval = setInterval(nextSlide, 3500);
  }

  function stopAutoplay() {
    if (autoplayInterval) clearInterval(autoplayInterval);
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.getAttribute('data-index') || 0);
      updateSlide(idx);
      startAutoplay();
    });
  });

  window.addEventListener('resize', () => {
    updateSlide(currentIndex);
  });

  startAutoplay();
</script>
