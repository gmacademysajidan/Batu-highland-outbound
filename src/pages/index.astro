---
import Layout from '../layouts/Layout.astro';
import { servicePackages, destinations, galleryItems, blogPosts, siteConfig, getWhatsAppUrl } from '../data/content';

const popularPackages = [
  servicePackages.find(p => p.id === 'team-building'),
  servicePackages.find(p => p.id === 'corporate-gathering'),
  servicePackages.find(p => p.id === 'outbound-rafting'),
  servicePackages.find(p => p.id === 'paket-standard')
].filter(Boolean);

const testimonials = [
  {
    name: "Hendra Wijaya",
    role: "HRD Director",
    company: "PT Karya Abadi Nusantara",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop",
    quote: "Program Team Building bersama Ruang Rimba benar-benar memecah sekat birokrasi antar divisi kantor kami. Rundown tertata rapi, Master Game sangat komunikatif dan sesi debriefing-nya memberikan wawasan nyata bagi kepemimpinan tim.",
    rating: 5
  },
  {
    name: "Ratna Kusuma Dewi",
    role: "Ketua Panitia Family Gathering",
    company: "Paguyuban Bank Mandiri Syariah",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=200&auto=format&fit=crop",
    quote: "Keluarga besar kami sangat menikmati seluruh rangkaian games dari anak-anak hingga kakek nenek. Fasilitas aula tertutup membuat kami merasa tenang saat sempat gerimis turun sore hari. Makanan liwetnya juga sangat lezat!",
    rating: 5
  },
  {
    name: "Drs. Ahmad Fauzi, M.Pd",
    role: "Pembina Kesiswaan OSIS",
    company: "SMA Cendekia Bangsa",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop",
    quote: "LDKS siswa kami dipandu dengan kedisiplinan tinggi tanpa ada unsur perpeloncoan. Anak-anak belajar mandiri, empati sosial dan cinta alam. Sertifikasi keselamatan instrukturnya terbukti sangat profesional.",
    rating: 5
  },
  {
    name: "Bambang Sudirjo",
    role: "General Affair Manager",
    company: "Logistik Prima Express",
    avatar: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=200&auto=format&fit=crop",
    quote: "Kombinasi Outbound dan Rafting di Sahabat Air Batu memberikan suntikan adrenalin yang luar biasa bagi 120 staf logistik kami. Urusan perizinan, bus, makan dan foto diselesaikan beres tanpa kami repot.",
    rating: 5
  }
];

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": siteConfig.name,
      "url": `https://${siteConfig.domain}`,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `https://${siteConfig.domain}/blog?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "LocalBusiness",
      "name": siteConfig.name,
      "telephone": siteConfig.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address,
        "addressLocality": "Kota Batu",
        "addressRegion": "Jawa Timur",
        "addressCountry": "ID"
      },
      "description": siteConfig.description
    }
  ]
};
---

<Layout
  title={`${siteConfig.name} - ${siteConfig.tagline}`}
  description={siteConfig.description}
  schema={homeSchema}
>
  <!-- 1. HERO BANNER -->
  <section class="relative bg-[#173D32] text-white overflow-hidden py-20 lg:py-28">
    <div class="absolute inset-0 opacity-25 mix-blend-overlay">
      <img
        src="https://images.unsplash.com/photo-1510312305653-8ed496efae75?q=80&w=1920&auto=format&fit=crop"
        alt="Suasana Alam Rimba Outbound"
        class="w-full h-full object-cover"
      />
    </div>
    
    <div class="absolute inset-0 bg-gradient-to-r from-[#173D32] via-[#173D32]/90 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#657A50]/40 border border-[#657A50] text-[#E8DFC9] text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Partner Outbound & Gathering Tepercaya
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white">
            Eksplorasi Kekuatan Tim Anda di Tengah Keasrian Rimba Raya.
          </h1>

          <p class="text-base sm:text-lg text-[#E8DFC9] font-normal leading-relaxed max-w-2xl">
            Solusi komprehensif outbound perusahaan, employee gathering, pembentukan karakter sekolah, dan petualangan rafting serta offroad dengan standar keselamatan terverifikasi.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="/paket"
              class="px-7 py-3.5 rounded-xl bg-[#E8DFC9] text-[#173D32] font-bold text-sm hover:bg-white transition text-center shadow-lg"
            >
              Jelajahi Pilihan Paket
            </a>
            <a
              href={getWhatsAppUrl("Halo Ruang Rimba Outbound, saya ingin konsultasi kebutuhan acara perusahaan kami.")}
              target="_blank"
              rel="noopener noreferrer"
              class="px-7 py-3.5 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-sm transition text-center flex items-center justify-center gap-2 shadow-lg"
            >
              <svg class="w-5 h-5 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              Konsultasi WhatsApp Cepat
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative">
            <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl border-4 border-[#657A50]/40 relative">
              <img
                src="https://images.unsplash.com/photo-1526772662000-3f88f10405ff?q=80&w=800&auto=format&fit=crop"
                alt="Kegiatan Team Building Ruang Rimba"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white text-[#173D32] p-4 rounded-2xl shadow-xl border border-[#E8DFC9] flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-[#E8DFC9] text-[#173D32] flex items-center justify-center font-bold text-2xl">
                ★
              </div>
              <div>
                <div class="font-bold text-lg leading-tight">100% Fleksibel</div>
                <div class="text-xs text-gray-500">Sesuaikan Anggaran & Target Tim</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. TENTANG WEBSITE / BRAND OVERVIEW -->
  <section class="py-16 lg:py-20 bg-white border-b border-[#E8DFC9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 relative">
          <div class="rounded-3xl overflow-hidden shadow-xl border border-[#E8DFC9]">
            <img
              src="https://images.unsplash.com/photo-1544717305-2782549b5136?q=80&w=800&auto=format&fit=crop"
              alt="Profil Fasilitator Ruang Rimba"
              class="w-full h-[380px] object-cover"
            />
          </div>
          <div class="absolute -bottom-5 -right-5 bg-[#173D32] text-white p-5 rounded-2xl shadow-xl border border-[#657A50]/50 max-w-xs hidden sm:block">
            <div class="text-xs font-bold text-[#E8DFC9] uppercase">Metode Reflektif</div>
            <div class="text-sm font-semibold mt-1">Experiential Learning: Do, Reflect, Apply.</div>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block">Tentang Ruang Rimba</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#173D32] tracking-tight leading-tight">
            Partner Terpercaya Penyelenggaraan Outbound & Pengembangan Tim.
          </h2>
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            Ruang Rimba Outbound merupakan platform penyedia jasa outbound profesional, team building, family gathering korporasi, kepemimpinan siswa, serta wisata petualangan alam terbuka. Kami memadukan keindahan lanskap pegunungan dengan kurikulum simulasi luar ruang yang dirancang terstruktur dan berorientasi pada keselamatan.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 items-center">
            <a
              href="/tentang-kami"
              class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[#173D32] hover:text-[#657A50] underline underline-offset-4 transition"
            >
              Pelajari Profil & Legalitas Kami &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. STATS SECTION -->
  <section class="py-12 bg-[#F8F7F2] border-b border-[#E8DFC9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9]/80 shadow-sm">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#173D32] mb-1">16+</div>
          <div class="text-xs font-semibold uppercase text-gray-500 tracking-wider">Pilihan Modul Outbound</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9]/80 shadow-sm">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#173D32] mb-1">5+</div>
          <div class="text-xs font-semibold uppercase text-gray-500 tracking-wider">Kawasan Venue Terverifikasi</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9]/80 shadow-sm">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#173D32] mb-1">100%</div>
          <div class="text-xs font-semibold uppercase text-gray-500 tracking-wider">Standard Safety & P3K</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-[#E8DFC9]/80 shadow-sm">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#173D32] mb-1">24/7</div>
          <div class="text-xs font-semibold uppercase text-gray-500 tracking-wider">Konsultasi Respon Cepat</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. KEUNGGULAN WEB / NILAI BISNIS -->
  <section class="py-16 lg:py-20 bg-white border-b border-[#E8DFC9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block mb-2">Mengapa Memilih Kami</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#173D32] tracking-tight">
          Keunggulan Layanan Ruang Rimba
        </h2>
        <p class="text-sm text-gray-600 mt-2">
          Dedikasi kami adalah menghadirkan ketenangan bagi panitia dan kepuasan maksimal bagi seluruh peserta.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-[#F8F7F2] border border-[#E8DFC9] space-y-3 hover:border-[#657A50] transition">
          <div class="w-12 h-12 rounded-xl bg-[#173D32] text-[#E8DFC9] flex items-center justify-center font-bold text-xl">
            01
          </div>
          <h3 class="text-lg font-bold text-[#173D32]">Safety First Standard</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Seluruh wahana, tali karmantel, helm rafting, dan jalur petualangan telah melalui uji kelayakan dengan rasio fasilitator aman dan tim medis lapangan siaga penuh.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#F8F7F2] border border-[#E8DFC9] space-y-3 hover:border-[#657A50] transition">
          <div class="w-12 h-12 rounded-xl bg-[#173D32] text-[#E8DFC9] flex items-center justify-center font-bold text-xl">
            02
          </div>
          <h3 class="text-lg font-bold text-[#173D32]">Experiential Learning Insight</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Bukan sekadar hiburan fisik. Fasilitator kami terlatih memandu sesi tanya-jawab reflektif (*debriefing*) agar nilai kerjasama tim langsung berdampak pada produktivitas kerja nyata.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#F8F7F2] border border-[#E8DFC9] space-y-3 hover:border-[#657A50] transition">
          <div class="w-12 h-12 rounded-xl bg-[#173D32] text-[#E8DFC9] flex items-center justify-center font-bold text-xl">
            03
          </div>
          <h3 class="text-lg font-bold text-[#173D32]">All-In One Management</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Mulai dari booking venue, aula indoor cadangan hujan, katering prasmanan lezat, dokumentasi foto drone, hingga seragam kaos kami kelola rapi dalam satu pintu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FASILITAS & LAYANAN -->
  <section class="py-16 lg:py-20 bg-[#F8F7F2] border-b border-[#E8DFC9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block mb-2">Sarana & Prasarana</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#173D32] tracking-tight">
            Fasilitas & Layanan Pendukung
          </h2>
        </div>
        <a href="/fasilitas" class="text-xs font-bold text-[#173D32] hover:text-[#657A50] transition mt-4 md:mt-0">
          Lihat Seluruh Fasilitas &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {destinations.slice(0, 3).map((dest) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-[#E8DFC9] shadow-sm hover:shadow-md transition">
            <div class="h-48 overflow-hidden">
              <img src={dest.image} alt={dest.name} class="w-full h-full object-cover hover:scale-105 transition duration-500" />
            </div>
            <div class="p-5 space-y-3">
              <div class="text-[10px] uppercase font-bold text-[#657A50] tracking-wider">{dest.region}</div>
              <h3 class="font-bold text-base text-[#173D32]">{dest.name}</h3>
              <p class="text-xs text-gray-600 line-clamp-2">{dest.description}</p>
              <div class="text-xs font-semibold text-gray-700 pt-2 border-t border-[#E8DFC9]">
                Kapasitas: <span class="text-[#173D32]">{dest.capacity}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. PROGRAM OUTBOUND DIMINATI -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block mb-2">Katalog Terfavorit</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#173D32] tracking-tight">
        Program Outbound Paling Diminati
      </h2>
      <p class="text-sm text-gray-600 mt-2">
        Pilihan paket populer yang terbukti sukses membangun antusiasme ribuan peserta.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {popularPackages.map((pkg) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E8DFC9] flex flex-col group">
          <div class="relative h-48 overflow-hidden">
            <img
              src={pkg?.heroImage}
              alt={pkg?.title}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
            <div class="absolute top-3 left-3 bg-[#173D32]/85 backdrop-blur-xs text-[#E8DFC9] text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider">
              {pkg?.categoryLabel}
            </div>
          </div>
          <div class="p-5 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="font-bold text-base text-[#173D32] mb-2 group-hover:text-[#657A50] transition">
                <a href={`/${pkg?.slug}`}>{pkg?.title}</a>
              </h3>
              <p class="text-xs text-gray-600 line-clamp-3 mb-4 leading-relaxed">
                {pkg?.shortDesc}
              </p>
            </div>
            <div class="pt-4 border-t border-[#E8DFC9]/60 flex items-center justify-between">
              <a
                href={`/${pkg?.slug}`}
                class="text-xs font-bold text-[#173D32] hover:text-[#657A50] transition"
              >
                Detail Rundown &rarr;
              </a>
              <a
                href={getWhatsAppUrl(`Halo Ruang Rimba, saya tertarik dengan paket ${pkg?.title}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[11px] font-semibold bg-[#173D32] text-[#E8DFC9] px-3 py-1.5 rounded-lg hover:bg-[#657A50] transition"
              >
                Tanya WA
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/paket"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#173D32] hover:text-[#657A50] transition underline underline-offset-4"
      >
        Lihat Seluruh 16 Pilihan Paket Outbound &rarr;
      </a>
    </div>
  </section>

  <!-- 7. GALERI DOKUMENTASI -->
  <section class="py-16 bg-[#F8F7F2] border-t border-[#E8DFC9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block mb-2">Dokumentasi Asli</span>
        <h2 class="text-3xl font-extrabold text-[#173D32] tracking-tight">Galeri Dokumentasi Kegiatan</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        {galleryItems.slice(0, 6).map((item) => (
          <div class="group relative rounded-xl overflow-hidden aspect-square border border-[#E8DFC9]">
            <img src={item.imageUrl} alt={item.title} class="w-full h-full object-cover group-hover:scale-110 transition duration-300" />
            <div class="absolute inset-0 bg-[#173D32]/75 opacity-0 group-hover:opacity-100 transition flex flex-col justify-end p-2.5 text-white">
              <span class="text-[9px] uppercase font-bold text-[#E8DFC9]">{item.category}</span>
              <span class="text-[11px] font-semibold line-clamp-1">{item.title}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/galeri" class="text-xs font-bold text-[#173D32] hover:underline">
          Buka Halaman Galeri Lengkap &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 8. ARTIKEL & TIPS -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#657A50] block mb-2">Pusat Informasi</span>
        <h2 class="text-3xl font-extrabold text-[#173D32] tracking-tight">Artikel & Tips Outbound</h2>
      </div>
      <a href="/blog" class="text-xs font-bold text-[#173D32] hover:text-[#657A50] transition mt-4 md:mt-0">
        Baca Semua Panduan &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {blogPosts.map((post) => (
        <article class="bg-white rounded-2xl overflow-hidden border border-[#E8DFC9] shadow-sm hover:shadow-md transition flex flex-col">
          <div class="h-44 overflow-hidden">
            <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition duration-300" />
          </div>
          <div class="p-5 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[11px] text-gray-500 mb-2">
                <span class="font-bold text-[#657A50]">{post.category}</span>
                <span>{post.date}</span>
              </div>
              <h3 class="font-bold text-sm text-[#173D32] hover:text-[#657A50] transition leading-snug mb-2">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed">
                {post.summary}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[#E8DFC9]/60">
              <a href={`/blog/${post.slug}`} class="text-xs font-bold text-[#173D32] hover:underline">
                Baca Selengkapnya &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 9. TESTIMONI (AUTO-SLIDE PADA MOBILE) -->
  <section class="py-16 bg-[#173D32] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
