---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { galleryItems, getWhatsAppUrl } from '../data/content';

const categories = ['Semua', 'Corporate Gathering', 'Team Building', 'Family Gathering', 'Outbound Sekolah', 'Adventure', 'Camping'];
---

<Layout
  title="Galeri Dokumentasi Kegiatan - Ruang Rimba Outbound"
  description="Kumpulan dokumentasi foto dan video asli kegiatan team building, family gathering, outbound sekolah, rafting, dan adventure offroad."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: 'Galeri Dokumentasi' }]} />
  </div>

  <section class="bg-[#173D32] text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E8DFC9] block mb-2">Dokumentasi Asli</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Galeri Kegiatan Ruang Rimba</h1>
      <p class="text-sm text-[#E8DFC9] mt-2 leading-relaxed">
        Rekam jejak antusiasme, kehangatan tawa, dan kekompakan ribuan peserta di berbagai lanskap alam terbuka Nusantara.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10" id="filter-container">
      {categories.map((cat, idx) => (
        <button
          class={`filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition ${
            idx === 0
              ? 'bg-[#173D32] text-white'
              : 'bg-white text-gray-700 hover:bg-[#E8DFC9] border border-[#E8DFC9]'
          }`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Gallery Grid with Lightbox Trigger -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6" id="gallery-grid">
      {galleryItems.map((item) => (
        <div
          class="gallery-card bg-white rounded-2xl overflow-hidden border border-[#E8DFC9] shadow-sm hover:shadow-xl transition group cursor-pointer"
          data-category={item.category}
          data-img={item.imageUrl}
          data-title={item.title}
          data-location={item.location}
        >
          <div class="h-64 overflow-hidden relative">
            <img
              src={item.imageUrl}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80 group-hover:opacity-100 transition"></div>
            
            <div class="absolute top-3 left-3 bg-[#173D32]/90 backdrop-blur-xs text-[#E8DFC9] text-[10px] font-bold px-2.5 py-1 rounded">
              {item.category}
            </div>

            <div class="absolute bottom-3 left-3 right-3 text-white">
              <h3 class="font-bold text-sm leading-snug">{item.title}</h3>
              <p class="text-[11px] text-gray-300 mt-1 flex items-center gap-1">
                <svg class="w-3 h-3 text-[#E8DFC9]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                {item.location}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white text-3xl font-bold hover:text-gray-300">&times;</button>
    <div class="max-w-4xl max-h-[90vh] flex flex-col items-center">
      <img id="lightbox-img" src="" alt="Popup Preview" class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-2xl" />
      <div class="text-center mt-4 text-white">
        <h3 id="lightbox-title" class="font-bold text-lg"></h3>
        <p id="lightbox-location" class="text-xs text-gray-400 mt-1"></p>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <section class="py-16 bg-[#F8F7F2]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#173D32] rounded-3xl p-8 sm:p-12 lg:p-14 text-white shadow-2xl border-2 border-[#657A50]/40 relative overflow-hidden">
        
        <!-- Background accent subtle -->
        <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-[#657A50]/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -top-16 w-64 h-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 text-center max-w-2xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#657A50]/40 border border-[#657A50] text-[#E8DFC9] text-xs font-semibold uppercase tracking-wider">
            Dokumentasi & Media Event
          </div>

          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
            Ingin Dokumentasi Profesional Seperti Ini di Acara Anda?
          </h2>

          <p class="text-xs sm:text-sm text-[#E8DFC9] leading-relaxed">
            Setiap paket kegiatan outbound Batu Highland sudah termasuk tim fotografer dan videografer profesional untuk mengabadikan momen berharga Anda.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={getWhatsAppUrl("Halo Batu Highland Outbound, saya ingin menanyakan perihal paket outbound dengan dokumentasi lengkap.")}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#657A50] hover:bg-[#657A50]/90 text-white font-bold text-sm shadow-xl transition hover:scale-105 active:scale-95"
            >
              <svg class="w-5 h-5 text-emerald-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              Konsultasi via WhatsApp
            </a>
            <a
              href="/paket"
              class="w-full sm:w-auto px-6 py-4 rounded-xl border border-[#E8DFC9] text-[#E8DFC9] hover:bg-white/10 font-bold text-sm transition text-center"
            >
              Lihat Pilihan Paket
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  // Filter Functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.gallery-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#173D32]', 'text-white');
        b.classList.add('bg-white', 'text-gray-700');
      });
      btn.classList.add('bg-[#173D32]', 'text-white');
      btn.classList.remove('bg-white', 'text-gray-700');

      const selectedCat = btn.getAttribute('data-category');

      cards.forEach(card => {
        const itemCat = card.getAttribute('data-category');
        if (selectedCat === 'Semua' || itemCat === selectedCat) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox Modal Functionality
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalTitle = document.getElementById('lightbox-title');
  const modalLocation = document.getElementById('lightbox-location');
  const closeBtn = document.getElementById('lightbox-close');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const img = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const loc = card.getAttribute('data-location') || '';

      if (modalImg) modalImg.src = img;
      if (modalTitle) modalTitle.textContent = title;
      if (modalLocation) modalLocation.textContent = loc;
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });
</script>
